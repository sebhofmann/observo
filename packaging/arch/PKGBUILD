# Maintainer: Sebastian Hofmann <sebastian.hofmann.1993@gmail.com>
#
# Builds Observo from the working tree this file lives in, including
# uncommitted changes. Build and install with:
#
#   paru -Bi packaging/arch

pkgname=observo-git
pkgver=2.0.0.r32.g4323cd4
pkgrel=1
pkgdesc='A fast, native desktop client for Zabbix problems'
arch=('x86_64')
url='https://github.com/sebhofmann/observo'
license=('GPL-3.0-only')
depends=(
  'alsa-lib'
  'gcc-libs'
  'glibc'
  'libxcb'
  'libxkbcommon'
  'libxkbcommon-x11'
  'vulkan-icd-loader'
  'wayland'
)
makedepends=('cargo' 'git')
provides=('observo')
conflicts=('observo')
options=('!lto' '!debug')

_root="$(realpath "${startdir:-.}/../..")"

pkgver() {
  local version
  version="$(sed -n 's/^version = "\(.*\)"/\1/p' "$_root/Cargo.toml" | head -n1)"
  printf '%s.r%s.g%s' "$version" \
    "$(git -C "$_root" rev-list --count HEAD)" \
    "$(git -C "$_root" rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=1.96.0
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=1.96.0
  export CARGO_TARGET_DIR="$srcdir/target"
  # Keep build paths out of the binary.
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/build --remap-path-prefix=$_root=/build/observo"
  cargo build --frozen --release
}

check() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=1.96.0
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --release --lib --bins
}

package() {
  install -Dm755 "$srcdir/target/release/observo" "$pkgdir/usr/bin/observo"
  install -Dm644 "$_root/resources/linux/de.paschty.observo.desktop" \
    "$pkgdir/usr/share/applications/de.paschty.observo.desktop"
  install -Dm644 "$_root/resources/linux/de.paschty.observo.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/de.paschty.observo.png"
  install -Dm644 "$_root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
